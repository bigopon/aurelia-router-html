{
  "name": "aurelia-router-html",
  "version": "0.1.5",
  "description": "HTML-first routing for Aurelia 2 applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigopon/aurelia-router-html"
  },
  "bugs": {
    "url": "https://github.com/bigopon/aurelia-router-html/issues"
  },
  "homepage": "https://aurelia-router-html.netlify.app/",
  "keywords": [
    "aurelia",
    "router",
    "routing",
    "aurelia-2"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "port": 9017,
  "scripts": {
    "dev": "vite dev",
    "dev:host": "vite dev --host 127.0.0.1",
    "example": "cross-env APP_PORT=9017 vite dev --host 127.0.0.1",
    "docs:serve": "npm --prefix docs-app run serve",
    "docs:preview": "npm --prefix docs-app run build:serve",
    "serve": "concurrently -n example,docs \"npm run example\" \"npm run docs:serve\" --kill-others",
    "build": "npm run clean && npm run build:package && npm run build:types",
    "build:package": "vite build --config vite.library.config.mjs --mode development && vite build --config vite.library.config.mjs --mode production",
    "build:types": "tsc --project tsconfig.build.json",
    "build:doc": "npm --prefix docs-app run build",
    "build:example": "vite build --outDir dist-example",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:node": "tsc -p tests/tsconfig.json && cross-env NODE_OPTIONS=--conditions=development mocha --require .tmp-node/tests/setup-node.js --ui bdd --reporter spec --timeout 5000 .tmp-node/tests/au-route.spec.js .tmp-node/tests/path-adapter.spec.js .tmp-node/tests/playground-path.spec.js",
    "test:matcher": "tsc -p tests/tsconfig.matcher.json && node .tmp-matcher/tests/route-context.spec.js",
    "test:e2e": "cross-env APP_PORT=9017 concurrently -n app,e2e \"node ./node_modules/vite/bin/vite.js dev --host 127.0.0.1\" \"node ./node_modules/@playwright/test/cli.js test\" --kill-others --success command-1",
    "test:e2e:watch": "cross-env APP_PORT=9017 concurrently -n app,e2e \"node ./node_modules/vite/bin/vite.js dev --host 127.0.0.1\" \"node ./node_modules/playwright-watch/cli.js test\" --kill-others --success command-1",
    "test:e2e:ci": "cross-env APP_PORT=9017 PLAYWRIGHT_CI_WEBSERVER=1 node ./node_modules/@playwright/test/cli.js test",
    "test": "npm run test:node && npm run test:matcher && npm run test:e2e",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@aurelia/expression-parser": "^2.0.0-rc.2",
    "@aurelia/kernel": "^2.0.0-rc.2",
    "@aurelia/runtime": "^2.0.0-rc.2",
    "@aurelia/runtime-html": "^2.0.0-rc.2",
    "@aurelia/template-compiler": "^2.0.0-rc.2"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "development": "./dist/index.dev.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@aurelia/expression-parser": "2.0.0-rc.2",
    "@aurelia/kernel": "2.0.0-rc.2",
    "@aurelia/platform-browser": "2.0.0-rc.2",
    "@aurelia/runtime": "2.0.0-rc.2",
    "@aurelia/runtime-html": "2.0.0-rc.2",
    "@aurelia/template-compiler": "2.0.0-rc.2",
    "@aurelia/testing": "2.0.0-rc.2",
    "@aurelia/vite-plugin": "2.0.0-rc.2",
    "@playwright/test": "1.39.0",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "10.0.6",
    "@types/node": "^20.16.10",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "jsdom": "24.1.0",
    "mocha": "10.3.0",
    "playwright-watch": "1.3.23",
    "ts-node": "10.9.2",
    "aurelia": "2.0.0-rc.2",
    "typescript": "5.7.2",
    "vite": "^7.0.2"
  }
}
