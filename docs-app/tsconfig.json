{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@aurelia/*": ["./node_modules/@aurelia/*"],
      "aurelia": ["./node_modules/aurelia"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true
  },
  "include": ["src", "../router"]
}
