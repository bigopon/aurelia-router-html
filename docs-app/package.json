{
  "name": "router-html-docs-app",
  "private": true,
  "version": "0.0.0",
  "port": 9027,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "serve": "vite serve --host 127.0.0.1 --port 9027",
    "build:serve": "npm run build && npm run preview",
    "preview": "vite preview --host 127.0.0.1 --port 9027",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e:ci": "cross-env APP_PORT=9027 PLAYWRIGHT_CI_WEBSERVER=1 node ../node_modules/@playwright/test/cli.js test --config playwright.config.cjs"
  },
  "dependencies": {
    "@aurelia/kernel": "2.0.0-rc.1",
    "@aurelia/runtime": "2.0.0-rc.1",
    "@aurelia/runtime-html": "2.0.0-rc.1",
    "@aurelia/template-compiler": "2.0.0-rc.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.10",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/theme-one-dark": "6.1.2",
    "aurelia": "2.0.0-rc.1",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@aurelia/vite-plugin": "2.0.0-rc.1",
    "esbuild-wasm": "0.17.8",
    "typescript": "5.7.2",
    "vite": "^7.0.2"
  }
